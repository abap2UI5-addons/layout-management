{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      // A release tag, not main: users install a release next to this addon
      // (abap2UI5 CONVENTIONS §9) - its client lifecycle and navigation API
      // (no _bind_edit( ), no *_model_update( )). scripts/core-pin.mjs reads
      // and moves it in every config and in the unit runner at once, bump-deps
      // moves it monthly, the weekly canary run lints once against main.
      // Without src/03 - the installation package (ICF handler, BSP), which
      // nothing here uses
      "branch": "1.151.0",
      "folder": "/abap2UI5",
      "files": "/src/0[0-2]/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    "errorNamespace": "."
  },
  "rules": {
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "definitions_top": false,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true,
    "exporting": true,
    "omit_parameter_name": true,
    "prefix_is_current_class": true,
    // --- from abap2UI5's rule set (abap2UI5/abaplint.jsonc) ---
    "7bit_ascii": true,
    "add_test_attributes": true,
    "aff_and_xml": true,
    "allowed_object_naming": true,
    // the vendored z2ui5_cl_layo_context stays as abap-util ships it
    // (DELETE tab. inside its LOOP in itab_filter_by_t_range)
    "ambiguous_statement": {
      "exclude": [
        "/src/03/z2ui5_cl_layo_context\\."
      ]
    },
    "avoid_use": {
      "break": true,
      "defaultKey": true,
      "define": true,
      "describeLines": true,
      "exclude": [],
      "exportToDatabase": true,
      "exportToMemory": true,
      "severity": "Error",
      "skipQuickFix": false,
      "statics": true,
      "testSeams": true
    },
    "begin_single_include": true,
    "call_transaction_authority_check": true,
    "catch_and_raise": true,
    "cds_association_name": true,
    "cds_field_order": true,
    "cds_parser_error": true,
    "chain_mainly_declarations": true,
    "check_abstract": true,
    "check_text_elements": true,
    "check_transformation_exists": true,
    "classic_exceptions_overlap": true,
    "clear_exporting_parameters": true,
    "cloud_types": true,
    "colon_missing_space": true,
    "constant_classes": true,
    "constructor_visibility_public": true,
    "contains_tab": true,
    "dangerous_statement": {
      "editorCallForReport": true,
      "ignoreRAPQueryProvider": true,
      "deleteDynpro": true,
      "deleteReport": true,
      "deleteTextpool": true,
      "dynamicSQL": true,
      // the sample shows what the select-options are for: a SELECT with the
      // WHERE clause filter_get_sql_where( ) built from the user's ranges
      "exclude": [
        "/src/01/z2ui5_cl_layo_sample_08\\."
      ],
      "execSQL": true,
      "exportDynpro": true,
      "generateDynpro": true,
      "generateReport": true,
      "generateSubroutine": true,
      "insertReport": true,
      "insertTextpool": true,
      "kernelCall": true,
      "severity": "Error",
      "systemCall": true
    },
    "db_operation_in_loop": true,
    "description_empty": true,
    "dynpro_checks": true,
    "easy_to_find_messages": true,
    "empty_event": true,
    "empty_statement": true,
    "empty_structure": {
      "loopAllowIfSubrc": true,
      "loop": false,
      "if": true,
      "while": true,
      "case": true,
      "select": true,
      "do": true,
      "at": true,
      "try": true,
      "when": false,
      "catch": true
    },
    "expand_macros": true,
    "fm_global_parameters_obsolete": true,
    "forbidden_identifier": true,
    "forbidden_pseudo_and_pragma": {
      "exclude": [],
      "ignoreGlobalClassDefinition": false,
      "ignoreGlobalInterface": false,
      "pragmas": [],
      "pseudo": [],
      "severity": "Error"
    },
    "forbidden_void_type": {
      "check": [
        "^boole_d$",
        "^char10$",
        "^char12$",
        "^char2$",
        "^char20$",
        "^char30$",
        "^char4$",
        "^char50$",
        "^char70$",
        "^cl_abap_syst",
        "^cl_aff_",
        "^cl_aucv_test_runner_abstract$",
        "^cl_aucv_test_runner_standard$",
        "^cl_aunit_assert$",
        "^cl_axt_dbtable$",
        "^cl_blue_wb_utility$",
        "^cl_oo_source$",
        "^/ui2/cl_",
        "^cl_saunit_internal_result$",
        "^cl_srvd_wb_object_data$",
        "^cl_wb_object_operator_factory$",
        "^cl_wer_const$",
        "^cl_xco_",
        "^cx_aff_",
        "^cx_wb_object_operation_error$",
        "^cx_xco_",
        "^flag$",
        "^i18_a_langiso2$",
        "^if_adt_lock_handle$",
        "^if_aff_",
        "^if_satc_ci_variant_access$",
        "^if_saunit_internal_result$",
        "^if_saunit_internal_result_type$",
        "^if_srvd_types$",
        "^if_wb_adt_plugin_resource_co$",
        "^if_wb_object_data_selection_co$",
        "^if_wb_object_operator$",
        "^if_xco_",
        "^int4$",
        "^numc2$",
        "^sabp_t_tadir_keys$",
        "^sap_bool$",
        "^srcsystem$",
        "^stringtab$",
        "^sychar01$",
        "^sychar10$",
        "^sychar70$",
        "^sydatum$",
        "^sylangu$",
        "^syst_title$",
        "^syuzeit$",
        "^feld$",
        "^abap_boolean$"
      ],
      "exclude": []
    },
    "form_tables_obsolete": true,
    "fully_type_constants": {
      "checkData": true,
      "exclude": []
    },
    "fully_type_itabs": true,
    "function_module_recommendations": true,
    "functional_writing": {
      "exclude": [],
      "ignoreExceptions": true
    },
    "identical_conditions": true,
    "identical_contents": true,
    "identical_descriptions": true,
    "identical_form_names": true,
    "identical_move": true,
    "implicit_start_of_selection": true,
    "index_completely_contained": true,
    "inline_data_old_versions": true,
    "intf_referencing_clas": {
      "allow": [
        "^cl_abap_"
      ],
      "exclude": []
    },
    "invalid_table_index": true,
    "line_break_style": true,
    "local_testclass_consistency": true,
    "macro_naming": true,
    "main_file_contents": true,
    "many_parentheses": true,
    "max_one_method_parameter_per_line": true,
    "max_one_statement": true,
    "message_exists": true,
    "method_overwrites_builtin": {
      "exclude": [],
      "severity": "Error"
    },
    "mix_returning": true,
    "modify_only_own_db_tables": {
      "exclude": [],
      "ownTables": "^[yz]",
      "reportDynamic": true
    },
    "msag_consistency": true,
    "names_no_dash": true,
    "nesting": {
      "depth": 5,
      "exclude": []
    },
    "newline_between_methods": true,
    "no_aliases": true,
    "no_chained_assignment": true,
    "no_comments_between_methods": true,
    "no_external_form_calls": true,
    "nrob_consistency": true,
    "obsolete_statement": true,
    "omit_preceding_zeros": true,
    "omit_receiving": true,
    "parser_702_chaining": true,
    "parser_bad_exceptions": true,
    "parser_missing_space": true,
    "pragma_style": true,
    "prefer_abap_bool": true,
    "prefer_abap_bool_values": true,
    "prefer_is_not": true,
    "prefer_pragmas": true,
    "prefer_raise_exception_new": true,
    "prefer_returning_to_exporting": true,
    "prefer_xsdbool": true,
    "preferred_compare_operator": true,
    "preferred_parameter_ignored": true,
    "reduce_procedural_code": true,
    "reduce_string_templates": true,
    "redundant_conversion": true,
    "release_idoc": true,
    "remove_descriptions": {
      "exclude": [],
      "ignoreExceptions": false,
      "ignoreWorkflow": false,
      "severity": "Error"
    },
    "rfc_error_handling": true,
    "select_single_full_key": true,
    "selection_screen_naming": true,
    "sequential_blank": {
      "lines": 4,
      "exclude": [],
      "severity": "Warning"
    },
    "short_case": true,
    "sicf_consistency": true,
    "slow_parameter_passing": true,
    "sql_escape_host_variables": true,
    "sql_value_conversion": true,
    "strict_sql": true,
    "superfluous_value": true,
    "sy_modification": true,
    "tabl_enhancement_category": true,
    "tables_declared_locally": true,
    "try_without_catch": true,
    "type_form_parameters": true,
    "uncaught_exception": true,
    "unnecessary_loop_guard": true,
    "unnecessary_pragma": true,
    "unreachable_code": true,
    "unsecure_fae": true,
    "unused_ddic": true,
    "unused_macros": true,
    "unused_methods": true,
    "unused_types": true,
    "use_class_based_exceptions": true,
    "use_line_exists": true,
    "use_message_class": true,
    "use_new": true,
    "when_others_last": true,
    "whitespace_end": true,
    "wrong_abapdoc_position": true,
    "xml_bom": true,
    // added 2026-11: the rules of abap2UI5's abaplint.jsonc this repository
    // passes without a finding, with its settings, and allowed_object_types
    // with the object types this repository ships
    "abapdoc_html_tag": true,
    "abapdoc_leading_at": true,
    "abapdoc_parameter_names": true,
    "abapdoc_shorttext_length": true,
    "allowed_object_types": {
      "allowed": [
        "CLAS",
        "DEVC",
        "INTF",
        "TABL"
      ]
    },
    "bound_check_after_create": true,
    "cds_comment_style": true,
    "cds_legacy_view": true,
    "changing_sorted_line": true,
    "clear_after_declaration": true,
    "clear_before_overwrite": true,
    "constant_condition": true,
    "copy_of_initial_variable": true,
    "final_newline": true,
    // an allow list matching no object: the default, empty, allows every one
    "forbidden_kernel_write": {
      "allow": [
        "^$"
      ]
    },
    "inline_packed_computation": true,
    "no_mandt_in_database_operations": true,
    "object_naming": {
      "sxci": "^Z",
      "enhs": "^Z",
      "enho": "^Z",
      "cmod": "^Z",
      "form": "^Z",
      "sfpf": "^Z",
      "sfpi": "^Z",
      "aqqu": "^Z",
      "aqsg": "^Z",
      "aqbg": "^Z",
      "suso": "^Z",
      "sucu": "^Z",
      "wdya": "^Z",
      "wdyn": "^Z",
      "severity": "Error",
      "patternKind": "required",
      "ignoreNames": [],
      "ignorePatterns": [],
      "clas": "^Z2UI5_C(L|X)",
      "intf": "^Z2UI5_IF",
      "prog": "^Z",
      "fugr": "^Z",
      "tabl": "^Z",
      "ttyp": "^Z",
      "dtel": "^Z",
      "doma": "^Z",
      "msag": "^Z",
      "tran": "^Z",
      "enqu": "^EZ",
      "auth": "^Z",
      "pinf": "^Z",
      "idoc": "^Z",
      "xslt": "^Z",
      "ssfo": "^Z",
      "ssst": "^Z",
      "shlp": "^Z"
    },
    "range_row_values": true,
    "redundant_cast": true,
    "smim_consistency": true,
    "sort_empty_key": true,
    // added 2026-11 with their findings fixed (abap2UI5 settings), no exceptions
    "change_if_to_case": true,
    "delete_index_in_loop": true,
    "else_after_all_returns": true,
    "exit_or_check": true,
    "if_in_if": true,
    "static_call_via_instance": {
      "allowInTestclassIncludes": false
    },
    // the vendored z2ui5_cl_layo_context stays as abap-util ships it
    "subrc_after_assign": {
      "exclude": [
        "/src/03/z2ui5_cl_layo_context\\."
      ]
    },
    "unnecessary_chaining": true,
    "unnecessary_return": true,
    "unused_variables": {
      "skipAbstract": false,
      "severity": "Error",
      "skipNames": [
        "lv_dummy",
        "lv_dummy2",
        "lv_dummy3",
        "lv_dummy4",
        "<dummy>"
      ]
    },
    "use_bool_expression": true,
    // added 2026-11 with its findings fixed: UNASSIGN before an ASSIGN in a loop
    // (an inline FIELD-SYMBOL( ) of an ASSIGN COMPONENT became FIELD-SYMBOLS ... TYPE any)
    "is_assigned_in_loop": true,
    // added 2026-11: newer abaplint rules that report nothing here
    "abapdoc_short_link": true,
    "boolean_flag_via_if": true,
    "cast_via_generic_reference": true,
    // added 2026-11 on abaplint 2.120.116: every remaining rule of
    // `abaplint --default` is listed. Those that report nothing here, with
    // abap2UI5's settings (or the app rule set's, .github/abaplint/app-rules.json,
    // where abap2UI5 has none)
    "align_type_expressions": true,
    "bdef_check_syntax": true,
    "bdef_parser_error": true,
    "cds_check_syntax": true,
    "cds_naming": {
      "basicInterfaceView": "Z2UI5_",
      "compositeInterfaceView": "Z2UI5_",
      "consumptionView": "Z2UI5_",
      "basicRestrictedReuseView": "Z2UI5_",
      "compositeRestrictedReuseView": "Z2UI5_",
      "privateView": "Z2UI5_",
      "remoteAPIView": "Z2UI5_",
      "viewExtend": "Z2UI5_",
      "extensionIncludeView": "Z2UI5_",
      "derivationFunction": "Z2UI5_",
      "abstractEntity": "Z2UI5_"
    },
    "character_field_literal_blanks": true,
    "copy_chain": true,
    "field_symbol_never_assigned": true,
    // statements with a successor that this repository no longer uses -
    // listed so they do not come back (abaplint 2.120.116+). The
    // widely used READ TABLE / APPEND / CREATE OBJECT / ... follow
    // once the code no longer has them
    "forbidden_statement": {
      "statements": [
        "Describe",
        "Refresh",
        "Ranges",
        "SelectLoop",
        "Collect",
        "Overlay",
        "Leave",
        "TypePools",
        "Perform",
        "Form",
        "Write",
        "ReadTable",
        "Append",
        "GetReference",
        "Concatenate",
        "Condense",
        "Translate",
        "Replace",
        "Find",
        "Shift",
        "Check"
      ],
      // CreateObject and MoveCorresponding stay allowed: z2ui5_cl_layo_auth
      // creates the customer's class by name (CREATE OBJECT ... TYPE (name)),
      // and z2ui5_cl_layo_pop_w_sel moves between generic rows (TYPE any) -
      // neither NEW nor CORRESPONDING #( ) can take those
      // the vendored abap-util copies stay close to the master (AGENTS.md)
      "exclude": [
        "/src/03/z2ui5_cl_layo_context\\.",
        "/src/03/z2ui5_cx_layo_error\\."
      ]
    },
    "function_module_parameter_names": true,
    "inline_generic_source": true,
    "keyword_case": {
      "ignoreGlobalClassDefinition": false,
      "ignoreGlobalInterface": false,
      "ignoreFunctionModuleName": false,
      "ignoreGlobalClassBoundaries": false,
      "maxIssuesPerFile": 10,
      "style": "upper",
      "ignoreExceptions": true,
      "ignoreLowerClassImplmentationStatement": true,
      "ignoreKeywords": []
    },
    // 255: the longest line abapGit and the ABAP editor accept
    "line_length": {
      "maxIssuesPerFile": 10,
      "length": 255
    },
    "loop_target_misuse": true,
    "no_macros": true,
    "no_yoda_conditions": {
      "onlyConstants": true
    },
    "prefer_raise_message": true,
    "selection_screen_texts_missing": true,
    "sequential_read_sorted": true,
    "sort_required": true,
    "space_before_colon": true,
    "space_before_dot": true,
    "stale_subrc": true,
    "start_at_tab": true,
    "suspicious_loop": true,
    "sy_read_restriction": true,
    "try_cast_empty_catch": true,
    "unit_test_assertions": true,
    "unnecessary_copy": true,
    // added 2026-11 with their findings fixed: an alias of a value that never
    // changes, a pseudo comment aligned, end-of-line comments moved above
    // their statement, a comment that read as code reworded, a double space,
    // ORDER BY PRIMARY KEY on the table reads
    "alias_never_reassigned": true,
    "align_pseudo_comments": true,
    "check_comments": true,
    "commented_code": true,
    "double_space": {
      "skipKeywords": ["CHANGING","EXPORTING","OTHERS"],
      "keywords": false,
      "startParen": true,
      "endParen": false,
      "afterColon": true
    },
    "select_add_order_by": true,
    // added 2026-11 with their findings fixed and narrow exceptions:
    "check_subrc": {
      // a statement whose sy-subrc does not matter carries ##SUBRC_OK, as in
      // abap2UI5. The vendored abap-util copy is checked too (SLIN reports
      // an unchecked CALL FUNCTION ... EXCEPTIONS there as well)
      // every option named: an option left out of a rule object counts as off
      "openDataset": true,
      "authorityCheck": true,
      "selectSingle": true,
      "selectTable": true,
      "updateDatabase": true,
      "insertDatabase": true,
      "modifyDatabase": true,
      "deleteDatabase": true,
      "readTable": true,
      "assign": true,
      "find": true,
      "callFunction": true,
      "callMethod": true
    },
    // the layout manager hands out its layout popup (layout_popup( )), and the
    // popup works on a layout manager - the cycle is the API of today's merge
    "cyclic_oo": {
      "exclude": [
        "/src/03/z2ui5_cl_layo_manager\\.",
        "/src/03/z2ui5_cl_layo_pop_w_sel\\."
      ],
      "skip": [
        "Z2UI5_IF_APP",
        "Z2UI5_IF_CLIENT",
        "Z2UI5_CL_UI5_ACTION",
        "Z2UI5_CL_UI5_HANDLER"
      ],
      "skipSharedMemory": true,
      "skipTestclasses": true
    },
    // the XML parser and builder (parse, get_grid_layout, xml_build_table, ...),
    // save_layout / the popup view and data_conversion / copy_layouts / set_selkz:
    // splitting them is a refactoring, not a lint fix. The vendored
    // z2ui5_cl_layo_context stays as abap-util ships it (itab_filter_by_val)
    "cyclomatic_complexity": {
      "exclude": [
        "/src/03/z2ui5_cl_layo_context\\.",
        "/src/03/z2ui5_cl_layo_xml_tree\\.",
        "/src/03/z2ui5_cl_layo_xml_builder\\.",
        "/src/03/z2ui5_cl_layo_pop\\.",
        "/src/03/z2ui5_cl_layo_manager\\."
      ],
      "max": 10
    },
    "method_length": {
      "checkFunctionModules": true,
      "exclude": [
        "/src/03/z2ui5_cl_layo_context\\.",
        "/src/03/z2ui5_cl_layo_xml_tree\\.",
        "/src/03/z2ui5_cl_layo_xml_builder\\.",
        "/src/03/z2ui5_cl_layo_pop\\.",
        "/src/03/z2ui5_cl_layo_manager\\."
      ],
      "statements": 50,
      "errorWhenEmpty": false,
      "ignoreTestClasses": true,
      "checkForms": true
    },
    // the test doubles of the authorization hook are LTD_ classes (Clean ABAP)
    "local_class_naming": {
      "ignoreNames": [],
      "ignorePatterns": [],
      "patternKind": "required",
      "local": "^LCL_.+$",
      "exception": "^LCX_.+$",
      "test": "^LT(CL|D)_.+$"
    },
    // z2ui5_cx_layo_error is the vendored abap-util copy, kept as-is (AGENTS.md)
    "no_exclamation_escape": {
      "exclude": [
        "/src/03/z2ui5_cx_layo_error\\."
      ]
    },
    // SELECT * stays: every such read fills rows of the table type
    // (z2ui5_t_11 / z2ui5_t_12) - a copy, a display or the head handed to
    // z2ui5_if_layo_auth; SELECT ... ENDSELECT is still reported
    "select_performance": {
      "starOkayIfFewColumns": 10,
      "endSelect": true,
      "selectStar": false
    },
    // handle and control are public types of the manager that apps and
    // z2ui5_cl_layo_pop_w_sel address as z2ui5_cl_layo_manager=>handle /
    // =>control - renaming them breaks callers
    "types_naming": {
      "exclude": [
        "/src/03/z2ui5_cl_layo_manager\\."
      ],
      "pattern": "^TY_"
    },
    "unhandled_classic_exception": {
      // the vendored abap-util copy stays close to the master (AGENTS.md)
      "exclude": [
        "/src/03/z2ui5_cl_layo_context\\."
      ],
      "missingOthers": true,
      "missingExceptions": true,
      "missingErrorMessage": true,
      "allowLiteralArguments": true
    },
    // kept off. Layout rules that would fight the view-builder chain layout
    // (.claude/skills/view-chain-layout in abap2UI5) or the house alignment -
    // off in abap2UI5 and in the app rule set as well
    "align_parameters": false,
    "empty_line_in_statement": false,
    "in_statement_indentation": false,
    "indentation": true, // 0 findings here - on, so none come back (off in the abap2UI5 core)
    "keep_single_parameter_on_one_line": false,
    "line_break_multiple_parameters": false,
    "line_only_punc": true, // 0 findings here - on, so none come back (off in the abap2UI5 core)
    // inlining a temporary into its single use would pull whole builder chains
    // (toolbar, header) into a parameter list
    "single_use_expression_temp": false,
    // naming conventions this repository does not follow (no Hungarian
    // prefixes required) - off in abap2UI5 and in the app rule set
    "class_attribute_names": false,
    "local_variable_names": false,
    "method_parameter_names": false,
    "no_prefixes": false,
    // style preferences abap2UI5 and the app rule set both keep off
    "abapdoc": false,
    "generic_regex": true, // 0 findings here - on, so none come back (off in the abap2UI5 core)
    "no_inline_in_optional_branches": false,
    "prefer_corresponding": false,
    "prefer_inline": false,
    "prefer_inline_cast": false,
    "prefer_insert_into_table": false,
    "prefer_string_template": false,
    // the samples and the popups keep their state in public attributes the
    // view binds to; the manager's ms_layout / mt_* are its API - off in
    // abap2UI5 and the app rule set
    "no_public_attributes": false,
    // a layout for any table is dynamic by nature (ASSIGN COMPONENT, CREATE
    // DATA TYPE HANDLE / TYPE (name), dynamic method calls on RTTI) - off in
    // the app rule set
    "no_dynamic_stuff": false

  }
}

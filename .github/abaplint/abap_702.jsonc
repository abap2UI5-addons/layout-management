{
  "global": {
    "files": "/../../src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/open-abap/open-abap-core",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      "branch": "702",
      "folder": "/abap2UI5",
      "files": "/src/**/*.*"
    },
    {
      // the legacy utilities z2ui5_cl_util* / z2ui5_cx_util_error this addon
      // calls - moved out of the core's src/99/01 into abap2UI5-ext, which a
      // system running this addon installs next to abap2UI5
      "url": "https://github.com/abap2UI5/abap2UI5-ext",
      "branch": "702",
      "folder": "/abap2UI5-ext",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v702",
    "errorNamespace": "."
  },
  "rules": {
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "definitions_top": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true
  }
}
